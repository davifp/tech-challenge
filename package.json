{
  "name": "tech-challenge",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format:check": "turbo run format:check",
    "test": "node scripts/run-with-test-infrastructure.mjs pnpm test:check",
    "test:check": "turbo run test --concurrency=1",
    "build": "turbo run build",
    "test:e2e": "node scripts/run-with-test-infrastructure.mjs pnpm test:e2e:check",
    "test:e2e:check": "turbo run test:e2e",
    "quality": "node scripts/run-with-test-infrastructure.mjs pnpm quality:check",
    "quality:check": "pnpm lint && pnpm typecheck && pnpm format:check && pnpm test:check && pnpm build && pnpm test:e2e:check",
    "dev": "turbo run dev",
    "prepare": "lefthook install"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{md,json,yml,yaml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@tech-challenge/eslint-config": "workspace:*",
    "eslint": "^9.39.5",
    "lefthook": "^2.1.12",
    "lint-staged": "^17.4.1",
    "prettier": "^3.9.6",
    "turbo": "^2.10.12",
    "typescript": "^5.9.3"
  }
}
