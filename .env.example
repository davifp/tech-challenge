# Copie para .env antes de subir os servicos: cp .env.example .env

# ---- Banco de dados ----
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=challenge
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/challenge?schema=public
DATABASE_URL_TEST=postgresql://postgres:postgres@localhost:5432/challenge_test?schema=public

# ---- Kafka ----
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=tech-challenge
KAFKA_GROUP_ID_TRANSACTIONS=transactions-consumer
KAFKA_GROUP_ID_ANTI_FRAUD=anti-fraud-consumer
KAFKA_CONNECTION_TIMEOUT_MS=3000
KAFKA_REQUEST_TIMEOUT_MS=30000
KAFKA_RETRY_INITIAL_TIME_MS=300
KAFKA_RETRY_COUNT=5
KAFKA_SESSION_TIMEOUT_MS=30000
KAFKA_CONSUMER_MAX_ATTEMPTS=3
KAFKA_CONSUMER_RETRY_DELAY_MS=300

# ---- Outbox de transacoes ----
OUTBOX_DISPATCH_ENABLED=true
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=50
OUTBOX_RETRY_BASE_DELAY_MS=1000
OUTBOX_RETRY_MAX_DELAY_MS=60000

# ---- Portas das aplicacoes ----
TRANSACTIONS_PORT=3001
ANTI_FRAUD_PORT=3002

# ---- Frontend ----
NEXT_PUBLIC_API_URL=http://localhost:3001
