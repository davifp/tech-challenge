{
  "name": "@tech-challenge/transactions",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "nest start --watch",
    "generate": "prisma generate",
    "build": "nest build",
    "start": "node dist/main.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format:check": "prettier --check . --ignore-path ../../.prettierignore",
    "pretest": "prisma generate",
    "test": "pnpm test:unit && pnpm test:integration",
    "test:unit": "vitest run --config vitest.config.mts",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "quality": "pnpm lint && pnpm typecheck && pnpm format:check && pnpm test && pnpm build",
    "db:seed": "prisma db seed",
    "seed:demo": "tsx prisma/seed.demo.ts"
  },
  "prettier": "@tech-challenge/prettier-config",
  "dependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/swagger": "^12.0.1",
    "nestjs-zod": "^5.5.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "dotenv": "^17.4.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "uuid": "^11.1.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@tech-challenge/eslint-config": "workspace:*",
    "@tech-challenge/prettier-config": "workspace:*",
    "@tech-challenge/tsconfig": "workspace:*",
    "@tech-challenge/vitest-config": "workspace:*",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.1",
    "eslint": "^9.39.5",
    "prettier": "^3.9.6",
    "prisma": "^7.10.0",
    "tsx": "^4.20.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
