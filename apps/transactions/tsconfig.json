{
  "extends": "@tech-challenge/tsconfig/node.json",
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    "outDir": "./dist",
    "declaration": true,
    "sourceMap": true,
    "types": ["node"]
  },
  "include": [
    "src/**/*.ts",
    "prisma/**/*.ts",
    "test/**/*.ts",
    "prisma.config.ts",
    "prisma.test.config.ts",
    "vitest.config.mts",
    "vitest.integration.config.mts"
  ],
  "exclude": ["node_modules", "dist"]
}
