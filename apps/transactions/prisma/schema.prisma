generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Transaction {
  transactionExternalId   String            @id @default(uuid(7)) @db.Uuid
  idempotencyKey          String?           @unique @db.VarChar(64)
  bodyHash                String?           @db.VarChar(64)
  accountExternalIdDebit  String            @db.Uuid
  accountExternalIdCredit String            @db.Uuid
  value                   Decimal           @db.Decimal(19, 2)
  transferTypeId          Int
  transferType            TransactionType   @relation(fields: [transferTypeId], references: [id])
  transactionStatusId     Int
  transactionStatus       TransactionStatus @relation(fields: [transactionStatusId], references: [id])
  inboxEvents             InboxEvent[]
  outboxEvents            OutboxEvent[]
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt

  @@index([createdAt(sort: Desc)])
  @@index([transactionStatusId, createdAt(sort: Desc)])
  @@index([transferTypeId, createdAt(sort: Desc)])
}

model InboxEvent {
  eventId               String      @id @db.Uuid
  eventName             String      @db.VarChar(128)
  transactionExternalId String      @db.Uuid
  transaction           Transaction @relation(fields: [transactionExternalId], references: [transactionExternalId])
  processedAt           DateTime    @default(now())

  @@index([transactionExternalId])
}

model OutboxEvent {
  eventId       String      @id @db.Uuid
  aggregateId   String      @db.Uuid
  aggregate     Transaction @relation(fields: [aggregateId], references: [transactionExternalId])
  eventName     String      @db.VarChar(128)
  payload       Json
  attemptCount  Int         @default(0)
  nextAttemptAt DateTime    @default(now())
  publishedAt   DateTime?
  lastError     String?     @db.Text

  @@index([publishedAt, nextAttemptAt])
}

model TransactionType {
  id           Int           @id
  name         String        @unique @db.VarChar(32)
  transactions Transaction[]
}

model TransactionStatus {
  id           Int           @id
  name         String        @unique @db.VarChar(32)
  transactions Transaction[]
}
